# ─────────────────────────────────────────────────────────────
#  Inkwell — Firebase configuration
#  1. Copy this file to ".env.local"
#  2. Paste the values from Firebase Console → Project settings → Your apps
#  3. Restart the dev server (Ctrl+C, then npm run dev)
#
#  While these values are empty the app runs in Demo Mode
#  (data is stored in your browser's localStorage).
# ─────────────────────────────────────────────────────────────

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional — only needed if you enable Google Analytics in Firebase
VITE_FIREBASE_MEASUREMENT_ID=

# Optional — run against the local Firebase Emulator Suite instead of the cloud.
# Start them with `npm run emulators` and set this to true. Development only.
VITE_USE_FIREBASE_EMULATORS=false
